#!/usr/bin/env bash
# Faux journalctl
args="$*"
if [[ ${AUDITE_MOI_JOURNAL_SSH_ECHEC:-} == 1 && "$args" == *"-t sshd"* ]]; then
  echo "ssh journal inaccessible" >&2
  exit 1
fi
if [[ ${AUDITE_MOI_JOURNAL_NOYAU_ECHEC:-} == 1 && ( "$args" == *"-k -p err"* || "$args" == *"-k --since 7 days ago"* ) ]]; then
  echo "kernel journal inaccessible" >&2
  exit 1
fi
if [[ ${AUDITE_MOI_JOURNALCTL_ECHEC:-} == 1 && ( "$args" == *"-t sudo"* || "$args" == *"-t useradd"* ) ]]; then
  echo "journal inaccessible" >&2
  exit 1
fi
case "$args" in
  *--disk-usage*) echo "Archived and active journals take up 1.2G in the file system." ;;
  *"-k -p err"*) cat <<EOT
Oct 29 03:12:44 nas kernel: ata4.00: exception Emask 0x0 SAct 0x10000 SErr 0x0 action 0x0
Oct 29 03:12:44 nas kernel: ata4.00: failed command: READ FPDMA QUEUED
Oct 29 03:12:44 nas kernel: blk_update_request: I/O error, dev sdd, sector 1234567890 op 0x0:(READ)
Oct 29 21:56:00 nas systemd-fstab-generator[770945]: Failed to create unit file '/run/systemd/generator/mnt-data.mount', as it already exists. Duplicate entry in '/etc/fstab'?
EOT
  ;;
  *"-k --since 7 days ago"*) cat <<EOT
Oct 27 02:01:11 nas kernel: ffmpeg invoked oom-killer: gfp_mask=0x140cca(GFP_HIGHUSER_MOVABLE|__GFP_COMP), order=0
Oct 27 02:01:11 nas kernel: Out of memory: Killed process 81234 (ffmpeg) total-vm:6123456kB, anon-rss:3912345kB
EOT
  ;;
  *"-k -b"*) cat <<EOT
Oct 29 07:00:01 nas kernel: i915 0000:00:02.0: [drm] GT0: GuC firmware i915/tgl_guc_70.bin version 70.20.0
Oct 29 07:00:01 nas kernel: i915 0000:00:02.0: [drm] GT0: HuC firmware i915/tgl_huc.bin version 7.9.3
Oct 29 07:00:01 nas kernel: i915 0000:00:02.0: [drm] GT0: HuC: authenticated for all workloads
Oct 29 07:00:02 nas kernel: [drm] amdgpu kernel modesetting enabled.
Oct 29 07:00:03 nas kernel: amdgpu 0000:03:00.0: amdgpu: SMU is initialized successfully!
Oct 29 07:00:03 nas kernel: amdgpu 0000:03:00.0: amdgpu: Will use PSP to load VCN firmware
EOT
  ;;
  *"-t sshd"*) cat <<EOT
2026-10-28T21:14:02+0100 nas sshd[1201]: Invalid user admin from 218.92.0.112 port 51234
2026-10-28T21:14:05+0100 nas sshd[1201]: Failed password for invalid user admin from 218.92.0.112 port 51234 ssh2
2026-10-28T21:14:09+0100 nas sshd[1203]: Failed password for root from 218.92.0.112 port 51240 ssh2
2026-10-28T23:40:11+0100 nas sshd[1302]: Failed password for root from 45.148.10.12 port 40022 ssh2
2026-10-29T08:02:10+0100 nas sshd[1402]: Accepted publickey for olivier from 192.168.1.20 port 50122 ssh2: ED25519 SHA256:abc
2026-10-29T09:30:44+0100 nas sshd[1502]: Failed password for olivier from 192.168.1.20 port 50200 ssh2
EOT
  ;;
  *"-t sudo"*) echo "2026-10-29T08:03:00+0100 nas sudo[1500]:  olivier : TTY=pts/0 ; PWD=/home/olivier ; USER=root ; COMMAND=/usr/bin/apt update" ;;
  *) ;;
esac
