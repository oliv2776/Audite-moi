<?xml version="1.0"?>
<opnsense>
  <system>
    <hostname>routeur</hostname>
    <webgui>
      <protocol>https</protocol>
      <port>443</port>
      <authmode>Local Database</authmode>
    </webgui>
    <ssh>
      <enabled>enabled</enabled>
      <permitrootlogin>1</permitrootlogin>
      <passwordauth>1</passwordauth>
    </ssh>
    <user>
      <name>root</name>
      <scope>system</scope>
      <password>$2y$10$SECRETHASHNEPASAFFICHER</password>
    </user>
    <authserver>
      <name>Local Database</name>
      <type>local</type>
    </authserver>
  </system>
  <interfaces>
    <wan>
      <if>igc0</if>
      <descr>WAN</descr>
      <enable>1</enable>
      <ipaddr>dhcp</ipaddr>
    </wan>
    <lan>
      <if>igc1</if>
      <descr>LAN</descr>
      <enable>1</enable>
      <ipaddr>192.168.1.1</ipaddr>
      <subnet>24</subnet>
    </lan>
    <opt1>
      <if>vlan0.20</if>
      <descr>IOT</descr>
      <enable>1</enable>
      <ipaddr>192.168.20.1</ipaddr>
      <subnet>24</subnet>
    </opt1>
    <opt2>
      <if>vlan0.30</if>
      <descr>INVITES</descr>
      <enable>1</enable>
      <ipaddr>10.30.0.1</ipaddr>
      <subnet>16</subnet>
    </opt2>
  </interfaces>
  <nat>
    <rule>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><network>wanip</network><port>2222</port></destination>
      <target>192.168.1.10</target>
      <local-port>22</local-port>
      <descr>SSH NAS</descr>
      <associated-rule-id>nat_1</associated-rule-id>
    </rule>
    <rule>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><network>wanip</network><port>32400</port></destination>
      <target>192.168.1.10</target>
      <local-port>32400</local-port>
      <descr>Plex</descr>
    </rule>
    <rule>
      <disabled>1</disabled>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><network>wanip</network><port>8080</port></destination>
      <target>192.168.1.50</target>
      <local-port>80</local-port>
      <descr>Ancien test</descr>
    </rule>
  </nat>
  <filter>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><network>192.168.1.10</network><port>2222</port></destination>
      <associated-rule-id>nat_1</associated-rule-id>
    </rule>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>udp</protocol>
      <source><any/></source>
      <destination><network>(self)</network><port>51820</port></destination>
      <descr>WireGuard</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>wan</interface>
      <protocol>tcp</protocol>
      <source><any/></source>
      <destination><network>(self)</network><port>443</port></destination>
      <descr>Admin a distance</descr>
    </rule>
    <rule>
      <type>pass</type>
      <interface>lan</interface>
      <protocol>any</protocol>
      <source><network>lan</network></source>
      <destination><any/></destination>
    </rule>
    <rule>
      <type>pass</type>
      <interface>opt1</interface>
      <ipprotocol>inet</ipprotocol>
      <protocol>any</protocol>
      <source><network>opt1</network></source>
      <destination><any/></destination>
      <descr>IoT vers Internet</descr>
    </rule>
  </filter>
  <installedpackages>
    <miniupnpd>
      <config>
        <enable>on</enable>
        <iface_array>lan</iface_array>
      </config>
    </miniupnpd>
  </installedpackages>
  <OPNsense>
    <IDS>
      <general>
        <enabled>0</enabled>
      </general>
    </IDS>
    <wireguard>
      <server>
        <servers>
          <server>
            <privkey>SECRETWGNEPASAFFICHER=</privkey>
          </server>
        </servers>
      </server>
    </wireguard>
  </OPNsense>
</opnsense>
