def act_planification(v, cx):
    p = planning(v)
    ecrire_surcharge(cx.systemd, "audite-moi.timer", "# Écrit par l'interface d'Audite-moi (Réglages > Planification)\n[Timer]\nOnCalendar=\nOnCalendar={}\n".format(oncalendar(p)))
    ecrire_surcharge(cx.systemd, "audite-moi.service", "# Écrit par l'interface d'Audite-moi (Réglages > Planification)\n[Service]\nEnvironment=AUDITE_MOI_GARDER={}\n".format(p["garder"]))
    systemctl("daemon-reload")
    if p["actif"]:
        rc, s = systemctl("enable", "audite-moi.timer")
        rc2, s2 = systemctl("restart", "audite-moi.timer")
        if rc or rc2:
            raise Refus("le minuteur n'a pas pu être activé : " + (s or s2)[-200:])
        msg = "Audit automatique planifié ; {} rapports conservés.".format(p["garder"])
    else:
        systemctl("disable", "--now", "audite-moi.timer")
        msg = "Audit automatique désactivé ; {} rapports conservés.".format(p["garder"])
    return True, msg, ["planification des audits"]


def act_interface(v, cx):
    try:
        with open(cx.web, encoding="utf-8") as f:
            web = json.load(f)
        st = os.stat(cx.web)
    except (OSError, ValueError):
        raise Refus("configuration de l'interface illisible ({})".format(cx.web))
    changes = []
    if "duree_session_h" in v:
        d = entier(v.get("duree_session_h"), 1, 168, "durée de session (heures)")
        if d != web.get("duree_session_h"):
            web["duree_session_h"] = d
            changes.append("durée de session")
    if v.get("mot_de_passe"):
        web["mot_de_passe"] = hash_mdp(v["mot_de_passe"])
        changes.append("mot de passe de l'interface")
    if not changes:
        return True, "Aucun changement.", []
    ecrire_atomique(cx.web, json.dumps(web, ensure_ascii=False, indent=2) + "\n", st.st_mode & 0o777, st.st_uid, st.st_gid)
    systemctl("restart", "--no-block", "audite-moi-web.service")
    return True, "Interface redémarrée : reconnectez-vous" + (" avec le nouveau mot de passe." if "mot de passe de l'interface" in changes else "."), changes


