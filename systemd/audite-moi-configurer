def exporter(cx):
    """Vue publique des réglages pour l'interface : aucun secret, seulement s'il est défini."""
    c = lire_conf(cx.conf)
    web = lire_json(cx.web, {})
    p = planning_actuel(cx.systemd)
    cle = c.get("OPNSENSE_KEY", "")
    d = {
        "date": int(time.time()),
        "controles": {"externe": est_oui(c.get("EXTERNE", "oui")), "domaines_extra": c.get("DOMAINES_EXTRA", ""),
                      "scan_reseau": est_oui(c.get("SCAN_RESEAU", "oui")), "scan_reseaux": c.get("SCAN_RESEAUX", "")},
        "sauvegardes": lire_sauvegardes(c.get("SAUVEGARDES", "")),
        "opnsense": {"url": c.get("OPNSENSE_URL", ""), "cle_definie": bool(cle), "cle_fin": cle[-4:] if len(cle) > 12 else "",
                     "secret_defini": bool(c.get("OPNSENSE_SECRET")),
                     "verifier_tls": est_oui(c.get("OPNSENSE_VERIFIER_TLS", "oui"))},
        "telegram": {"jeton_defini": bool(c.get("TELEGRAM_TOKEN")), "chat_id": c.get("TELEGRAM_CHAT_ID", ""),
                     "alertes": est_oui(c.get("ALERTES", "oui")), "interface_url": c.get("INTERFACE_URL", "")},
        "domaines": {"domaines": c.get("DOMAINES", ""), "selecteurs": c.get("DKIM_SELECTEURS", ""),
                     "sous_domaines": est_oui(c.get("SOUS_DOMAINES", "oui"))},
        "vulnerabilites": {"actif": est_oui(c.get("VULNERABILITES", "oui")), "versions_lan": est_oui(c.get("VERSIONS_LAN", "oui")),
                           "internetdb": est_oui(c.get("INTERNETDB", "oui")), "nvd_cle_definie": bool(c.get("NVD_API_KEY"))},
        "planification": p,
        "interface": {"ecoute": web.get("ecoute", ""), "port": web.get("port", ""), "https": bool(web.get("tls_cert")),
                      "duree_session_h": web.get("duree_session_h", 12)},
    }
    ecrire_json(os.path.join(cx.etat, "configuration.json"), d, cx.groupe)
    return d


def alertes_actives(conf):
    return bool(conf.get("TELEGRAM_TOKEN") and conf.get("TELEGRAM_CHAT_ID")) and est_oui(conf.get("ALERTES", "oui"))


# ---------------------------------------------------------------- principal --
def traiter(dem, cx):
    ident = str(dem.get("id", ""))[:40]
    if not re.fullmatch(r"[A-Za-z0-9_-]{8,40}", ident):
        raise Refus("identifiant de demande invalide")
    action = dem.get("action")
    if action not in ACTIONS:
        raise Refus("réglage inconnu")
    valeurs = dem.get("valeurs") or {}
    if not isinstance(valeurs, dict):
        raise Refus("valeurs illisibles")
    res = ACTIONS[action][1](valeurs, cx)
    ok, message, changes = res[0], res[1], res[2]
    return {"id": ident, "action": action, "libelle": ACTIONS[action][0], "ok": ok, "message": message,
            "changements": changes, "test_ok": res[3] if len(res) > 3 else None}


def main():
    ap = argparse.ArgumentParser(description="Réglages d'Audite-moi modifiés depuis l'interface web")
    ap.add_argument("--demande", default="/var/lib/audite-moi/demande/configurer")
    ap.add_argument("--etat", default="/var/lib/audite-moi/etat")
    ap.add_argument("--conf", default="/etc/audite-moi/audit.conf")
    ap.add_argument("--web", default="/etc/audite-moi/web.json")
    ap.add_argument("--systemd", default="/etc/systemd/system")
    ap.add_argument("--groupe", default="audite-moi")
    ap.add_argument("--exporter", action="store_true", help="écrit seulement la vue publique des réglages (configuration.json)")
    a = ap.parse_args()
    cx = Contexte(a)
    if a.exporter:
        exporter(cx)
        return
    try:
        with open(a.demande, encoding="utf-8") as f:
            brut = f.read(16384)
    except OSError:
        return
    finally:
        try:
            os.remove(a.demande)   # sinon audite-moi-configurer.path relancerait en boucle
        except OSError:
            pass
    dem = {}
    try:
        with open(a.conf, encoding="utf-8") as f:
            avant = f.read()
    except OSError:
        avant = ""
    try:
        dem = json.loads(brut)
        if not isinstance(dem, dict):
            dem = {}
            raise Refus("demande illisible")
        ent = traiter(dem, cx)
    except Refus as exc:
        act = dem.get("action") if isinstance(dem.get("action"), str) else ""
        ent = {"id": str(dem.get("id", ""))[:40], "action": act[:40], "libelle": ACTIONS.get(act, ("Réglage",))[0],
               "ok": False, "message": str(exc), "changements": [], "refus": True}
    except (ValueError, OSError) as exc:
        ent = {"id": str(dem.get("id", ""))[:40], "action": "", "libelle": "Erreur", "ok": False,
               "message": "Erreur : {}".format(str(exc)[:300]), "changements": [], "refus": True}
    ent["date"] = int(time.time())
    ent["par"] = str(dem.get("par", ""))[:60]
    journal = lire_json(os.path.join(a.etat, "configuration-journal.json"), [])
    journal.append(ent)
    ecrire_json(os.path.join(a.etat, "configuration-journal.json"), journal[-GARDE_JOURNAL:], a.groupe)
    try:
        exporter(cx)
    except (OSError, ValueError):
        pass
    ecrire_json(os.path.join(a.etat, "configuration-resultat.json"), ent, a.groupe)
    if ent.get("changements") or ent.get("refus"):
        if ent.get("refus"):
            texte = "⚠️ <b>Modification de réglage refusée</b>\n{} : {}".format(html.escape(ent["libelle"]), html.escape(ent["message"][:300]))
        else:
            texte = "⚙️ <b>Réglages modifiés depuis l'interface</b>\n{}".format(html.escape(", ".join(ent["changements"])))
        if ent["par"]:
            texte += "\nDemandé depuis {}".format(html.escape(ent["par"]))
        if alertes_actives(lire_conf(a.conf)):
            notifier(texte, a.conf)
        elif avant and alertes_actives(lire_conf_texte(avant)):
            # les alertes viennent d'être coupées : prévenir avec l'ancienne configuration,
            # pour qu'une désactivation ne passe pas inaperçue
            notifier(texte, avant_fichier(avant, a.etat))
    print("{} : {} — {}".format(datetime.datetime.fromtimestamp(ent["date"]).isoformat(), ent["libelle"], "réussi" if ent["ok"] else "échec"),
          file=sys.stderr)


if __name__ == "__main__":
    main()
