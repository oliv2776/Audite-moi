[Unit]
Description=Audite-moi : relevé des disques et des pools, connexions reçues et alertes Telegram
Documentation=https://github.com/oliv2776/Audite-moi
After=zfs.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/audite-moi/audite-moi-mesures
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=10min
# Lecture seule : smartctl, zpool et la table des connexions ont besoin de root, mais rien n'est modifié
ProtectSystem=strict
ReadWritePaths=/var/lib/audite-moi/etat /var/lib/audite-moi/demande
ProtectHome=read-only
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
NoNewPrivileges=yes
