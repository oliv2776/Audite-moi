[Unit]
Description=Audite-moi : interface web
Documentation=https://github.com/oliv2776/Audite-moi
After=network-online.target
Wants=network-online.target

[Service]
User=audite-moi
Group=audite-moi
ExecStart=/usr/bin/python3 /usr/local/lib/audite-moi/audite-moi-web.py --config /etc/audite-moi/web.json
Restart=on-failure
RestartSec=5
# Durcissement : le serveur web n'a besoin que de lire les rapports et de déposer une demande
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/audite-moi/demande
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
