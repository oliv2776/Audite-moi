#!/usr/bin/env python3
"""Audite-moi — relevé de l'état des disques et des pools (exécuté en root).

Lancé toutes les 10 minutes par audite-moi-mesures.timer, ou à la demande de
l'interface web (fichier /var/lib/audite-moi/demande/mesurer). Écrit un petit
fichier JSON lu par la page « Matériel » de l'interface :
  * pools ZFS : espace utilisable, état, erreurs, principaux jeux de données ;
  * autres volumes (/, /boot…) ;
  * disques : SMART (état, température, heures, secteurs, erreurs CRC, usure).

Lecture seule. Les disques en veille ne sont PAS réveillés (smartctl -n standby) :
leurs dernières valeurs connues sont conservées.
"""
import argparse
import grp
import html
import ipaddress
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.parse
import urllib.request

SYS_BLOCK = os.environ.get("AUDITE_MOI_SYS_BLOCK", "/sys/block")
FS_LOCAUX = {"ext2", "ext3", "ext4", "xfs", "btrfs", "vfat", "f2fs", "exfat"}
ID_DOCKER = re.compile(r"/[0-9a-f]{64}(-init)?$")
SEUILS = {}


def charger_seuils():
    """Seuils par défaut (seuils.json livré avec Audite-moi) et valeurs choisies dans l'interface."""
    ici = os.path.dirname(os.path.abspath(__file__))
    defs = [os.environ.get("AUDITE_MOI_SEUILS_DEF", ""), os.path.join(ici, "seuils.json"), os.path.join(ici, "..", "seuils.json"),
            "/usr/local/lib/audite-moi/seuils.json"]
    d = next((lire_json(f, {}) for f in defs if f and os.path.isfile(f)), {})
    o = lire_json(os.environ.get("AUDITE_MOI_SEUILS", "/var/lib/audite-moi/reglages/seuils.json"), {})
    for g in d.get("groupes", []):
        for x in g.get("seuils", []):
            v = o.get(x["cle"])
            ok = isinstance(v, int) and not isinstance(v, bool) and x["min"] <= v <= x["max"]
            SEUILS[x["cle"]] = v if ok else x["defaut"]


def S(cle, defaut):
    return SEUILS.get(cle, defaut)
CONNTRACK = os.environ.get("AUDITE_MOI_CONNTRACK", "/proc/net/nf_conntrack")


def cmd(*args, timeout=60):
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout
    except (OSError, subprocess.SubprocessError):
        return 127, ""


def entier(v):
    try:
        return int(v)
    except (TypeError, ValueError):
        return None


def disque_de(chemin):
    """/dev/sda1 → sda ; /dev/nvme0n1p4 → nvme0 (nom du contrôleur, comme smartctl --scan)."""
    n = os.path.basename(os.path.realpath(chemin)) if chemin.startswith("/dev/disk/") else os.path.basename(chemin)
    m = re.match(r"(nvme\d+)n\d+(p\d+)?$", n)
    if m:
        return m.group(1)
    m = re.match(r"((?:sd|vd|hd|xvd)[a-z]+)\d*$", n)
    return m.group(1) if m else n


# --------------------------------------------------------------------- ZFS --
def pools():
    rc, out = cmd("zpool", "list", "-H", "-o", "name")
    if rc != 0:
        return [], {}
    noms = [l.strip() for l in out.splitlines() if l.strip()]
    datasets = {}
    rc, out = cmd("zfs", "list", "-H", "-p", "-t", "filesystem,volume", "-o", "name,used,avail,refer,compressratio,encryption,mountpoint")
    for l in out.splitlines():
        c = l.split("\t")
        if len(c) >= 3:
            datasets[c[0]] = (entier(c[1]) or 0, entier(c[2]) or 0, c[6] if len(c) > 6 else "")
    res, membres = [], {}
    for nom in noms:
        p = {"nom": nom}
        rc, out = cmd("zpool", "list", "-H", "-p", "-o", "size,alloc,free,frag,cap,health,dedupratio", nom)
        c = out.strip().split("\t")
        if len(c) >= 6:
            p.update(brut=entier(c[0]), alloue=entier(c[1]), frag=entier(c[3]), remplissage=entier(c[4]), etat=c[5])
        racine = datasets.get(nom)
        if racine:
            p["utilise"], p["libre"] = racine[0], racine[1]
            p["taille"] = racine[0] + racine[1]
        enfants = [(n, v[0]) for n, v in datasets.items() if n.count("/") == 1 and n.startswith(nom + "/") and not ID_DOCKER.search(n)]
        enfants.sort(key=lambda x: -x[1])
        p["jeux"] = [{"nom": n.split("/", 1)[1], "utilise": u} for n, u in enfants[:6]]
        if len(enfants) > 6:
            p["jeux"].append({"nom": "autres ({})".format(len(enfants) - 6), "utilise": sum(u for _, u in enfants[6:])})
        # membres du pool, rôle (données / cache / journal / secours) et erreurs
        rc, out = cmd("zpool", "status", "-LP", nom)
        role, disques, dispo = "donnees", [], []
        for l in out.splitlines():
            t = l.split()
            if t and role == "donnees" and re.match(r"(mirror|raidz\d|draid\d?\S*)-\d+$", t[0]):
                v = re.sub(r"-\d+$", "", t[0])
                if v not in dispo:
                    dispo.append(v)
            if len(t) == 1 and t[0] in ("cache", "logs", "spares", "special", "dedup"):
                role = t[0]
                continue
            if t and t[0].startswith("/dev/"):
                d = disque_de(t[0])
                err = [entier(x) or 0 for x in t[2:5]] if len(t) >= 5 else [0, 0, 0]
                disques.append({"disque": d, "role": role, "etat": t[1] if len(t) > 1 else "", "erreurs": err})
                membres[d] = {"pool": nom, "role": role, "erreurs": err, "etat_zfs": t[1] if len(t) > 1 else ""}
        m = re.search(r"scan: (.*)", out)
        p["scrub"] = m.group(1).strip() if m else ""
        p["disques"] = disques
        p["disposition"] = ", ".join(dispo) or ("simple" if disques else "")
        res.append(p)
    return res, membres


def volumes():
    vus, res = set(), []
    try:
        lignes = open("/proc/mounts", encoding="utf-8").read().splitlines()
    except OSError:
        return res
    for l in lignes:
        c = l.split()
        if len(c) < 3 or c[2] not in FS_LOCAUX or not c[0].startswith("/dev/") or c[0] in vus:
            continue
        point = c[1].replace("\\040", " ")
        if point.startswith(("/snap", "/var/lib/docker", "/run", "/sys", "/proc")):
            continue
        try:
            s = os.statvfs(point)
        except OSError:
            continue
        taille = s.f_blocks * s.f_frsize
        if taille <= 0:
            continue
        vus.add(c[0])
        libre = s.f_bavail * s.f_frsize
        res.append({"point": point, "type": c[2], "source": c[0], "taille": taille, "utilise": taille - s.f_bfree * s.f_frsize, "libre": libre})
    res.sort(key=lambda v: (v["point"] != "/", v["point"]))
    return res


# -------------------------------------------------------------------- SMART --
def attr(d, *ids):
    for a in (d.get("ata_smart_attributes") or {}).get("table", []) or []:
        if a.get("id") in ids:
            return a
    return None


def brut(d, *ids):
    a = attr(d, *ids)
    if not a:
        return None
    v = (a.get("raw") or {}).get("value")
    return v if isinstance(v, int) else None


def lire_disque(nom, info, membre, avant, maintenant):
    chemin = info.get("name") or "/dev/" + nom
    rc, out = cmd("smartctl", "-j", "-a", "-n", "standby,3", chemin, timeout=90)
    try:
        d = json.loads(out) if out.strip() else {}
    except ValueError:
        d = {}
    r = {"nom": nom, "chemin": chemin, "pool": membre.get("pool"), "role": membre.get("role"), "mesure": maintenant}
    if rc == 3 or "STANDBY" in json.dumps(d.get("smartctl", {}).get("messages", [])):
        if avant:   # disque en veille : on garde le dernier relevé, sans le réveiller
            r.update({k: v for k, v in avant.items() if k not in ("veille", "pool", "role")})
            r["pool"], r["role"] = membre.get("pool"), membre.get("role")
        r["veille"] = True
        r.setdefault("etat", "veille")
        if r["etat"] == "ok":
            r["etat"] = "veille"
        return r
    if not d.get("device"):
        r.update(etat="inconnu", raisons=["SMART illisible (disque USB, contrôleur RAID ?)"])
        return r
    nvme = (d.get("device", {}).get("protocol") == "NVMe") or d.get("device", {}).get("type") == "nvme"
    rot = d.get("rotation_rate")
    try:
        bloc = nom + "n1" if nvme else nom
        rot_sys = open(os.path.join(SYS_BLOCK, bloc, "queue", "rotational")).read().strip() == "1"
    except OSError:
        rot_sys = None
    if nvme:
        typ = "NVMe"
    elif (isinstance(rot, int) and rot > 0) or (rot is None and rot_sys):
        typ = "HDD"
    else:
        typ = "SSD"
    taille = (d.get("user_capacity") or {}).get("bytes") or d.get("nvme_total_capacity")
    if not taille and d.get("nvme_namespaces"):
        taille = ((d["nvme_namespaces"][0].get("capacity") or {}).get("bytes"))
    r.update(type=typ, modele=d.get("model_name") or d.get("model_family") or "", serie=d.get("serial_number", ""), taille=taille,
             temperature=(d.get("temperature") or {}).get("current"), heures=(d.get("power_on_time") or {}).get("hours"),
             smart_ok=(d.get("smart_status") or {}).get("passed"))
    nv = d.get("nvme_smart_health_information_log") or {}
    if nvme:
        r.update(usure=nv.get("percentage_used"), erreurs_media=nv.get("media_errors"), reserve=nv.get("available_spare"))
    else:
        r.update(realloues=brut(d, 5), en_attente=brut(d, 197), irrecuperables=brut(d, 198), non_corrigees=brut(d, 187), crc=brut(d, 199))
        if typ == "SSD":
            a = attr(d, 177, 231, 233, 169)
            r["usure"] = max(0, 100 - a["value"]) if a and isinstance(a.get("value"), int) and a["value"] <= 100 else None
            if r["usure"] is None and brut(d, 202) is not None and brut(d, 202) <= 100:
                r["usure"] = brut(d, 202)   # Crucial/Micron : pourcentage de vie consommé
    # Historique des erreurs CRC : seule une HAUSSE récente est inquiétante (le compteur ne redescend jamais)
    crc = r.get("crc")
    hausse = (avant or {}).get("crc_hausse")
    if crc:
        if avant is None or (avant.get("crc") or 0) < crc:
            hausse = maintenant if avant is not None else (hausse or maintenant)
    r["crc_hausse"] = hausse

    crit, att = [], []
    if r["smart_ok"] is False:
        crit.append("SMART annonce une défaillance : remplacez le disque")
    if nvme:
        if nv.get("critical_warning"):
            crit.append("Alerte critique NVMe ({})".format(nv["critical_warning"]))
        if isinstance(nv.get("available_spare"), int) and isinstance(nv.get("available_spare_threshold"), int) \
                and nv["available_spare"] <= nv["available_spare_threshold"]:
            crit.append("Réserve de cellules épuisée ({} %)".format(nv["available_spare"]))
        if nv.get("media_errors"):
            att.append("{} erreur(s) de support".format(nv["media_errors"]))
    for cle, txt, seuil in (("en_attente", "secteur(s) en attente de réallocation", S("disque_en_attente_critique", 10)),
                            ("irrecuperables", "secteur(s) irrécupérable(s)", S("disque_en_attente_critique", 10)),
                            ("realloues", "secteur(s) réalloué(s)", S("disque_realloues_critique", 100)), ("non_corrigees", "erreur(s) non corrigée(s)", None)):
        if r.get(cle):
            (crit if seuil and r[cle] >= seuil else att).append("{} {}".format(r[cle], txt))
    if crc:
        fenetre = S("disque_crc_fenetre_jours", 7)
        if hausse and maintenant - hausse < fenetre * 86400:
            att.append("{} erreur(s) CRC, en hausse : câble SATA ou connecteur à vérifier".format(crc))
        else:
            r["note"] = "{} erreur(s) CRC anciennes, stables depuis plus de {} jours".format(crc, fenetre)
    t = r.get("temperature")
    if isinstance(t, int):
        k = {"HDD": "hdd", "SSD": "ssd", "NVMe": "nvme"}[typ]
        lim = (S("disque_temp_{}_attention".format(k), {"hdd": 50, "ssd": 60, "nvme": 70}[k]),
               S("disque_temp_{}_critique".format(k), {"hdd": 60, "ssd": 70, "nvme": 80}[k]))
        if t >= lim[1]:
            crit.append("Température très élevée ({} °C)".format(t))
        elif t >= lim[0]:
            att.append("Température élevée ({} °C)".format(t))
    u = r.get("usure")
    if isinstance(u, int):
        if u >= S("disque_usure_critique", 90):
            crit.append("Usure {} % : fin de vie".format(u))
        elif u >= S("disque_usure_attention", 80):
            att.append("Usure {} %".format(u))
    e = membre.get("erreurs") or [0, 0, 0]
    if any(e):
        att.append("Erreurs ZFS sur ce disque (lecture {}, écriture {}, somme de contrôle {})".format(*e))
    if membre.get("etat_zfs") and membre["etat_zfs"] not in ("ONLINE", "AVAIL", "INUSE"):
        crit.append("État dans le pool : {}".format(membre["etat_zfs"]))
    r["etat"] = "critique" if crit else "attention" if att else "ok"
    r["raisons"] = crit + att
    return r


def disques(membres, precedent, maintenant):
    rc, out = cmd("smartctl", "--scan-open", "-j")
    try:
        scan = json.loads(out).get("devices", [])
    except ValueError:
        scan = []
    avant = {d["nom"]: d for d in precedent.get("disques", []) if isinstance(d, dict) and d.get("nom")}
    res, vus = [], set()
    for info in scan:
        nom = os.path.basename(info.get("name", ""))
        if not nom or nom in vus:
            continue
        vus.add(nom)
        res.append(lire_disque(nom, info, membres.get(nom, {}), avant.get(nom), maintenant))
    res.sort(key=lambda d: (d.get("pool") is None, d.get("pool") or "", d.get("role") != "donnees", d["nom"]))
    return res


# ---------------------------------------------------------- fichiers d'état --
def ecrire_json(chemin, donnees, groupe, indent=None):
    tmp = chemin + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o640)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(donnees, f, ensure_ascii=False, indent=indent)
    try:
        os.chown(tmp, 0, grp.getgrnam(groupe).gr_gid)
    except (KeyError, OSError):
        pass
    os.replace(tmp, chemin)


def lire_json(chemin, defaut):
    try:
        with open(chemin, encoding="utf-8") as f:
            d = json.load(f)
        return d if isinstance(d, type(defaut)) else defaut
    except (OSError, ValueError):
        return defaut


def lire_conf(chemin):
    conf = {}
    try:
        lignes = open(chemin, encoding="utf-8").read().splitlines()
    except OSError:
        return conf
    for l in lignes:
        m = re.match(r"^\s*([A-Z_]+)\s*=\s*(.*?)\s*$", l)
        if m:
            v = m.group(2)
            if len(v) >= 2 and v[0] == v[-1] and v[0] in "\"'":
                v = v[1:-1]
            conf[m.group(1)] = v
    return conf


def oui(v):
    return str(v).strip().lower() in ("oui", "o", "yes", "y", "1", "true", "on")


# ----------------------------------------- ports en écoute et connexions reçues --
def ips_hote():
    rc, out = cmd("hostname", "-I")
    return set(out.split())


def ecoutes():
    """Ports en écoute hors boucle locale : {"tcp/22": "sshd"}."""
    res = {}
    rc, out = cmd("ss", "-H", "-tulpn")
    for l in out.splitlines():
        c = l.split()
        if len(c) < 5:
            continue
        loc = c[4]
        port, adr = loc.rsplit(":", 1)[-1], loc.rsplit(":", 1)[0].split("%")[0]
        if not port.isdigit() or adr.startswith("127.") or adr in ("[::1]", "::1"):
            continue
        m = re.search(r'"([^"]+)"', l)
        res.setdefault("{}/{}".format(c[0].rstrip("6"), port), m.group(1) if m else "noyau")
    return res


def publique(ip):
    try:
        return ipaddress.ip_address(ip).is_global
    except ValueError:
        return False


def connexions(ips, ecoute):
    """Connexions entrantes vues maintenant : {(proto, port, ip source)}."""
    vues = set()
    # Table de suivi des connexions du noyau : garde aussi les connexions récemment fermées et les ports Docker (DNAT).
    # À défaut de /proc/net/nf_conntrack, l'outil « conntrack » donne le même format avec -o extended.
    try:
        lignes = open(CONNTRACK, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        lignes = cmd("conntrack", "-L", "-o", "extended")[1].splitlines()
    for l in lignes:
        c = l.split()
        if len(c) < 4 or c[2] not in ("tcp", "udp"):
            continue
        kv = {}
        for t in c:
            if "=" in t:
                k, _, v = t.partition("=")
                kv.setdefault(k, v)          # première occurrence = sens d'origine
        if kv.get("dst") in ips and kv.get("src") not in ips and kv.get("dport", "").isdigit():
            vues.add((c[2], kv["dport"], kv.get("src", "")))
    rc, out = cmd("ss", "-H", "-tn", "state", "established")
    for l in out.splitlines():
        c = l.split()
        if len(c) < 4:
            continue
        loc, pair = c[-2], c[-1]
        port = loc.rsplit(":", 1)[-1]
        src = pair.rsplit(":", 1)[0].strip("[]").replace("::ffff:", "")
        if "tcp/" + port in ecoute and src not in ips and not src.startswith("127."):
            vues.add(("tcp", port, src))
    return vues


def trafic(chemin, ips, ecoute, maintenant, groupe):
    t = lire_json(chemin, {})
    t.setdefault("debut", maintenant)
    t["releves"] = t.get("releves", 0) + 1
    ports = t.setdefault("ports", {})
    for proto, port, src in connexions(ips, ecoute):
        e = ports.setdefault("{}/{}".format(proto, port), {})
        if e.get("vu") != maintenant:
            e["releves"] = e.get("releves", 0) + 1
        e["vu"] = maintenant
        if publique(src):
            ex = e.setdefault("exemples_publics", [])
            if src not in ex:
                ex.append(src)
                del ex[:-50]
                e["publiques"] = e.get("publiques", 0) + 1
    t["maj"] = maintenant
    ecrire_json(chemin, t, groupe)


# ------------------------------------------------- historique et tendances --
def historique(chemin, mes, maintenant):
    dernier = 0
    try:
        with open(chemin, "rb") as f:
            f.seek(0, 2)
            taille = f.tell()
            f.seek(max(0, taille - 4096))
            fin = f.read().decode("utf-8", "replace").strip().splitlines()
        dernier = json.loads(fin[-1]).get("t", 0) if fin else 0
    except (OSError, ValueError, IndexError):
        taille = 0
    if maintenant - dernier < 3500:      # un point par heure
        return
    point = {"t": maintenant,
             "pools": {p["nom"]: [p.get("utilise"), p.get("taille")] for p in mes["pools"] if p.get("taille")},
             "disques": {d["nom"]: [d.get("temperature"), d.get("crc"), d.get("realloues")] for d in mes["disques"] if not d.get("veille")}}
    with open(chemin, "a", encoding="utf-8") as f:
        f.write(json.dumps(point, separators=(",", ":")) + "\n")
    os.chmod(chemin, 0o640)
    if taille > 4_000_000:               # au-delà, on ne garde que deux ans
        lignes = [l for l in open(chemin, encoding="utf-8") if json.loads(l).get("t", 0) > maintenant - 730 * 86400]
        with open(chemin, "w", encoding="utf-8") as f:
            f.writelines(lignes)


def tendances(chemin, mes, maintenant):
    """Régression linéaire sur 30 jours : progression et date de remplissage de chaque pool."""
    series = {}
    try:
        for l in open(chemin, encoding="utf-8"):
            try:
                p = json.loads(l)
            except ValueError:
                continue
            if p.get("t", 0) < maintenant - 30 * 86400:
                continue
            for nom, (u, t) in p.get("pools", {}).items():
                if u is not None and t:
                    series.setdefault(nom, []).append((p["t"], u, t))
    except OSError:
        pass
    for pool in mes["pools"]:
        s = series.get(pool["nom"], [])
        if len(s) < 6 or s[-1][0] - s[0][0] < 3 * 86400:
            continue
        n = len(s)
        mx = sum(x for x, _, _ in s) / n
        my = sum(y for _, y, _ in s) / n
        den = sum((x - mx) ** 2 for x, _, _ in s)
        if not den:
            continue
        pente = sum((x - mx) * (y - my) for x, y, _ in s) / den * 86400      # octets par jour
        tend = {"octets_par_jour": int(pente), "jours_observes": round((s[-1][0] - s[0][0]) / 86400, 1)}
        u, t = pool.get("utilise"), pool.get("taille")
        if pente > 0 and u is not None and t:
            tend["seuil_critique"] = S("pool_critique", 90)
            for seuil, cle in ((S("pool_critique", 90) / 100.0, "jours_avant_critique"), (1.0, "jours_avant_plein")):
                reste = seuil * t - u
                tend[cle] = max(0, int(reste / pente)) if reste > 0 else 0
        pool["tendance"] = tend


# ------------------------------------------------------------- alertes --
def cle_constat(section, titre):
    k = re.sub(r"\d", "#", "{}|{}".format(section, titre))
    return re.sub(r"#+", "#", k)


def problemes(rapport):
    res = {}
    for c in rapport.get("constats", []):
        if c.get("niveau") in ("CRIT", "WARN") and not c.get("accepte"):
            res[c.get("cle") or cle_constat(c.get("section", ""), c.get("titre", ""))] = c
    return res


def oct_(n):
    n = float(n or 0)
    for u in ("o", "Ko", "Mo", "Go", "To", "Po"):
        if abs(n) < 1024 or u == "Po":
            return ("{:.0f} {}" if n >= 100 or u == "o" else "{:.1f} {}").format(n, u).replace(".", ",")
        n /= 1024


def e(s):
    return html.escape(str(s), quote=False)


def resume_rapport(nouveau, ancien):
    n = nouveau.get("notes", {})
    def note(k):
        x = n.get(k, {})
        txt = "{} {}".format(x.get("lettre", "?"), x.get("score", "?"))
        if ancien:
            d = x.get("score", 0) - ancien.get("notes", {}).get(k, {}).get("score", 0)
            txt += " (▲{})".format(d) if d > 0 else " (▼{})".format(-d) if d < 0 else " (=)"
        return txt
    l = ["📋 <b>Audit {} de {} terminé</b>".format(e(nouveau.get("mode", "")), e(nouveau.get("hote", ""))),
         "Santé {} · Sécurité {}".format(note("sante"), note("securite"))]
    pn = problemes(nouveau)
    if ancien:
        pa = problemes(ancien)
        nouv = [pn[k] for k in pn if k not in pa]
        for niv, ico, lib in (("CRIT", "🔴", "Nouveaux problèmes critiques"), ("WARN", "🟠", "Nouveaux avertissements")):
            x = [c for c in nouv if c["niveau"] == niv]
            if x:
                l.append("\n{} <b>{}</b> :".format(ico, lib))
                l += ["• " + e(c["titre"]) for c in x[:8]] + (["• … et {} autre(s)".format(len(x) - 8)] if len(x) > 8 else [])
        res = len([k for k in pa if k not in pn])
        if res:
            l.append("\n✅ {} problème(s) résolu(s)".format(res))
        if not nouv and not res:
            l.append("Rien de nouveau depuis l'audit précédent.")
    else:
        c = nouveau.get("compteurs", {})
        l.append("{} critique(s), {} avertissement(s)".format(c.get("CRIT", 0), c.get("WARN", 0)))
    for c in nouveau.get("constats", []):
        if c.get("titre", "").startswith("Nouveaux appareils depuis le dernier scan") and not c.get("accepte"):
            l.append("\n🆕 <b>{}</b>\n{}".format(e(c["titre"]), e("\n".join(c.get("detail", "").splitlines()[:6]))))
    return "\n".join(l)


def unites_sauvegarde():
    rc, out = cmd("systemctl", "list-timers", "--all", "--no-legend")
    res = {}
    for t in sorted(set(re.findall(r"[A-Za-z0-9@_.:-]+\.timer", out))):
        if not re.search(r"restic|borg|kopia|rclone|syncoid|zrepl|duplicity|rsnapshot|backup|sauvegarde", t, re.I) or "dpkg-db-backup" in t:
            continue
        svc = cmd("systemctl", "show", "-p", "Unit", "--value", t)[1].strip() or t[:-6] + ".service"
        res[svc] = cmd("systemctl", "show", "-p", "Result", "--value", svc)[1].strip()
    return res


def envoyer_telegram(conf, texte):
    if os.environ.get("AUDITE_MOI_TELEGRAM_FICHIER"):        # tests : on écrit le message au lieu de l'envoyer
        with open(os.environ["AUDITE_MOI_TELEGRAM_FICHIER"], "a", encoding="utf-8") as f:
            f.write(texte + "\n----\n")
        return True
    jeton, chat = conf.get("TELEGRAM_TOKEN", ""), conf.get("TELEGRAM_CHAT_ID", "")
    if not jeton or not chat:
        return False
    url = conf.get("INTERFACE_URL", "")
    if url:
        texte += '\n\n<a href="{}">Ouvrir Audite-moi</a>'.format(html.escape(url))
    donnees = urllib.parse.urlencode({"chat_id": chat, "text": texte[:4000], "parse_mode": "HTML", "disable_web_page_preview": "true"}).encode()
    try:
        req = urllib.request.Request("https://api.telegram.org/bot{}/sendMessage".format(jeton), data=donnees)
        with urllib.request.urlopen(req, timeout=20) as r:
            return bool(json.load(r).get("ok"))
    except (OSError, ValueError) as exc:
        sys.stderr.write("Telegram : envoi impossible ({})\n".format(type(exc).__name__))   # jamais le jeton dans les journaux
        return False


def alertes(conf, mes, ecoute, chemin_etat, rapports, maintenant, groupe):
    st = lire_json(chemin_etat, {})
    actif = bool(conf.get("TELEGRAM_TOKEN") and conf.get("TELEGRAM_CHAT_ID")) or bool(os.environ.get("AUDITE_MOI_TELEGRAM_FICHIER"))
    actif = actif and oui(conf.get("ALERTES", "oui"))
    premier = not st.get("actif")         # première exécution avec Telegram configuré : un message de bienvenue, pas de rafale
    msgs = []
    hote = socket.gethostname()

    # Pools : état, remplissage, date de remplissage prévue
    sp = st.setdefault("pools", {})
    for p in mes["pools"]:
        a = sp.setdefault(p["nom"], {})
        etat = p.get("etat", "")
        if etat and etat != "ONLINE" and a.get("etat") != etat:
            msgs.append("🔴 <b>Pool {} : {}</b>\nUn disque est défaillant ou absent : la redondance est réduite ou perdue.".format(e(p["nom"]), e(etat)))
        elif etat == "ONLINE" and a.get("etat") not in (None, "ONLINE"):
            msgs.append("✅ Pool {} de nouveau en ligne (ONLINE)".format(e(p["nom"])))
        a["etat"] = etat
        if p.get("taille"):
            pct = 100.0 * p["utilise"] / p["taille"]
            paliers = sorted({S("pool_attention", 80), S("pool_critique", 90), 95, 98})
            seuil = max([s for s in paliers if pct >= s] or [0])
            if seuil > a.get("seuil", 0):
                msgs.append("{} <b>Pool {} rempli à {:.0f} %</b> ({} libres)".format("🔴" if seuil >= S("pool_critique", 90) else "🟠", e(p["nom"]), pct, oct_(p["libre"])))
                a["seuil"] = seuil
            elif pct < a.get("seuil", 0) - 3:
                a["seuil"] = seuil
        j = (p.get("tendance") or {}).get("jours_avant_plein")
        if j is not None and j < S("alerte_pool_plein_jours", 30) and not a.get("bientot"):
            msgs.append("🟠 <b>Pool {} plein dans environ {} jours</b> au rythme actuel (+{} par jour)".format(
                e(p["nom"]), j, oct_(p["tendance"]["octets_par_jour"])))
            a["bientot"] = True
        elif j is None or j > 2 * S("alerte_pool_plein_jours", 30):
            a["bientot"] = False

    # Disques : changement d'état, erreurs CRC en hausse, disque disparu
    sd = st.setdefault("disques", {})
    vus = set()
    for d in mes["disques"]:
        vus.add(d["nom"])
        a = sd.get(d["nom"])
        etat = d.get("etat")
        nom = "{} ({})".format(d["nom"], d.get("modele") or d.get("type") or "?")
        if d.get("veille"):
            continue
        rang = {"ok": 0, "inconnu": 0, "attention": 1, "critique": 2}
        if a and rang.get(etat, 0) > rang.get(a.get("etat"), 0):
            msgs.append("{} <b>Disque {} : {}</b>\n{}".format("🔴" if etat == "critique" else "🟠", e(nom), "état critique" if etat == "critique" else "à surveiller",
                                                            e("\n".join("• " + r for r in d.get("raisons", [])))))
        elif a and etat == "ok" and a.get("etat") in ("attention", "critique"):
            msgs.append("✅ Disque {} de nouveau sain".format(e(nom)))
        elif a and d.get("crc") and a.get("crc") is not None and d["crc"] > a["crc"] and etat == a.get("etat"):
            msgs.append("🟠 <b>Erreurs CRC en hausse sur {}</b> : {} → {}\nCâble SATA ou connecteur à vérifier.".format(e(nom), a["crc"], d["crc"]))
        sd[d["nom"]] = {"etat": etat, "crc": d.get("crc"), "vu": maintenant}
    for nom, a in list(sd.items()):
        if nom not in vus:
            if not a.get("absent"):
                msgs.append("🔴 <b>Disque {} introuvable</b>\nIl n'apparaît plus : débranché, câble ou disque mort ?".format(e(nom)))
                a["absent"] = True
            if maintenant - a.get("vu", maintenant) > 30 * 86400:
                del sd[nom]

    # Nouveau port en écoute (non vu depuis 30 jours)
    se = st.setdefault("ecoutes", {})
    nouveaux = [k for k in ecoute if k not in se]
    if nouveaux and se:
        msgs.append("🆕 <b>Nouveau(x) port(s) en écoute sur {}</b>\n{}\nNormal si vous venez d'installer un service ; sinon, vérifiez.".format(
            e(hote), e("\n".join("• {} ({})".format(k, ecoute[k]) for k in sorted(nouveaux)[:10]))))
    for k in ecoute:
        se[k] = maintenant
    for k in [k for k, t in se.items() if maintenant - t > 30 * 86400]:
        del se[k]

    # Sauvegardes planifiées en échec
    ss_ = st.setdefault("sauvegardes", {})
    for svc, res in unites_sauvegarde().items():
        if res and res != "success" and ss_.get(svc, "success") == "success":
            msgs.append("🔴 <b>Sauvegarde en échec : {}</b>\nRésultat : {}. Journal : journalctl -u {}".format(e(svc), e(res), e(svc)))
        elif res == "success" and ss_.get(svc) not in (None, "success"):
            msgs.append("✅ Sauvegarde {} de nouveau réussie".format(e(svc)))
        ss_[svc] = res

    # Nouveau rapport d'audit
    try:
        noms = sorted(n for n in os.listdir(rapports) if re.match(r"^rapport-.+-\d{8}-\d{4}\.json$", n))
    except OSError:
        noms = []
    if noms and noms[-1] != st.get("rapport"):
        nouveau = lire_json(os.path.join(rapports, noms[-1]), {})
        ancien = lire_json(os.path.join(rapports, st["rapport"]), {}) if st.get("rapport") in noms else \
            (lire_json(os.path.join(rapports, noms[-2]), {}) if len(noms) > 1 else {})
        if st.get("rapport") is not None and nouveau:
            msgs.append(resume_rapport(nouveau, ancien))
        st["rapport"] = noms[-1]

    if actif and premier:
        pb = [d for d in mes["disques"] if d.get("etat") in ("attention", "critique")]
        txt = ["✅ <b>Alertes Audite-moi activées sur {}</b>".format(e(hote)),
               "Vous serez prévenu si un pool se dégrade ou se remplit, si un disque faiblit, si une sauvegarde échoue, si un nouveau port s'ouvre, et après chaque audit."]
        if pb:
            txt.append("\nÀ surveiller dès maintenant :\n" + e("\n".join("• {} : {}".format(d["nom"], " ; ".join(d.get("raisons", []))) for d in pb)))
        for p in mes["pools"]:
            if p.get("taille") and p["utilise"] / p["taille"] >= S("pool_attention", 80) / 100.0:
                txt.append("• Pool {} rempli à {:.0f} %".format(e(p["nom"]), 100.0 * p["utilise"] / p["taille"]))
        msgs = ["\n".join(txt)]
    envoye = False
    if actif and msgs:
        envoye = envoyer_telegram(conf, "\n\n".join(msgs))
        if envoye:
            st["dernier_envoi"] = maintenant
    st["actif"] = actif
    st["maj"] = maintenant
    if actif and msgs and not envoye:
        st["erreur"] = maintenant
    elif envoye:
        st.pop("erreur", None)
    ecrire_json(chemin_etat, st, groupe)
    return msgs


def trouver_chat(jeton):
    """Après avoir écrit au bot : identifiant de la conversation la plus récente."""
    with urllib.request.urlopen("https://api.telegram.org/bot{}/getUpdates".format(jeton), timeout=20) as r:
        d = json.load(r)
    for u in reversed(d.get("result", [])):
        m = u.get("message") or u.get("channel_post") or {}
        if m.get("chat", {}).get("id"):
            return m["chat"]["id"], m["chat"].get("first_name") or m["chat"].get("title") or ""
    return None, ""


def main():
    ap = argparse.ArgumentParser(description="Relevé des disques et des pools, observation des connexions et alertes d'Audite-moi")
    ap.add_argument("--sortie", default="/var/lib/audite-moi/etat/mesures.json")
    ap.add_argument("--demande", default="/var/lib/audite-moi/demande/mesurer")
    ap.add_argument("--groupe", default="audite-moi")
    ap.add_argument("--conf", default="/etc/audite-moi/audit.conf")
    ap.add_argument("--rapports", default="/var/lib/audite-moi/rapports")
    ap.add_argument("--test-telegram", action="store_true", help="envoie un message de test sur Telegram")
    ap.add_argument("--trouver-chat", action="store_true", help="lit le jeton du bot sur l'entrée standard et affiche l'identifiant de conversation")
    ap.add_argument("--notifier", action="store_true", help="envoie sur Telegram le texte lu sur l'entrée standard (si les alertes sont configurées)")
    a = ap.parse_args()
    if a.trouver_chat:
        ident, nom = trouver_chat(sys.stdin.readline().strip())
        if ident is None:
            sys.exit(1)
        print("{}\t{}".format(ident, nom))
        return
    conf = lire_conf(a.conf)
    charger_seuils()
    if a.notifier:
        texte = sys.stdin.read(3500).strip()
        if texte and oui(conf.get("ALERTES", "oui")):
            envoyer_telegram(conf, texte)
        return
    if a.test_telegram:
        ok = envoyer_telegram(conf, "✅ <b>Audite-moi</b> : les alertes Telegram fonctionnent sur {}.".format(html.escape(socket.gethostname())))
        print("Message envoyé." if ok else "Échec de l'envoi : vérifiez TELEGRAM_TOKEN et TELEGRAM_CHAT_ID dans {}.".format(a.conf))
        sys.exit(0 if ok else 1)
    try:
        os.remove(a.demande)   # sinon audite-moi-mesures.path relancerait la mesure en boucle
    except OSError:
        pass
    maintenant = int(time.time())
    etat = os.path.dirname(os.path.abspath(a.sortie))
    precedent = lire_json(a.sortie, {})
    p, membres = pools()
    res = {"horodatage": maintenant, "pools": p, "volumes": volumes(), "disques": disques(membres, precedent, maintenant)}
    for pool in res["pools"]:
        etats = [d.get("etat") for d in res["disques"] if d.get("pool") == pool["nom"]]
        types = {d.get("type") for d in res["disques"] if d.get("pool") == pool["nom"] and d.get("role") == "donnees" and d.get("type")}
        pool["type"] = types.pop() if len(types) == 1 else ("mixte" if types else "")
        pool["disques_critiques"] = etats.count("critique")
        pool["disques_attention"] = etats.count("attention")
    hist = os.path.join(etat, "historique.jsonl")
    historique(hist, res, maintenant)
    tendances(hist, res, maintenant)
    ecrire_json(a.sortie, res, a.groupe, indent=1)
    ecoute = ecoutes()
    trafic(os.path.join(etat, "trafic.json"), ips_hote(), ecoute, maintenant, a.groupe)
    alertes(conf, res, ecoute, os.path.join(etat, "alertes.json"), a.rapports, maintenant, a.groupe)


if __name__ == "__main__":
    main()
